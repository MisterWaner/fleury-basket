---
import Header from '@/components/Header/Header.astro';
import '../styles/global.css';

interface Props {
    title?: string;
    description?: string;
}

const { title, description = "Site officiel de Fleury Basket" } = Astro.props as Props;
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title || "Fleury Basket"} </title>
		<meta name="description" content={description} />
	</head>
	<body class="antialiased bg-fleury-pink/75 text-slate-950 min-h-screen flex flex-col">
		<Header />
		<slot />
	</body>
</html>
