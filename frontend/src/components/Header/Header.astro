---
import MainMenu  from '@/components/Header/MainMenu'
import { Image } from 'astro:assets'

import logo from "@/assets/fleury-basket.png"
---


<header class="w-full border-b bg-slate-950 backdrop-blur-md text-slate-50 sticky top-0 z-50 shadow-md">
    <div class="grid grid-cols-6 items-center px-4 py-3">
        <div class="col-span-4 md:col-span-2 flex items-center gap-2">
            <Image
                src={logo}
                alt="Fleury Basket"
                width={150}
                height={150}
                class="w-12 h-12 md:w-20 md:h-20 object-contain"
            />
            <p class="text-xl md:text-2xl lg:text-4xl font-bold font-montserrat">
                Fleury Basket
            </p>
        </div>

        <div class="col-end-7 justify-self-end">
            <MainMenu client:load />
        </div>
    </div>
</header>
